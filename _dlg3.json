[{"id":1,"shot_no":1,"character_id":null,"speaker_name":"字幕","text":"“当世间再无人记得，历史便真正死去。”","emotion":"悲伤","voice_id":"default","audio_url":null},{"id":2,"shot_no":5,"character_id":2,"speaker_name":"阿瑶","text":"师兄师兄！师父让我把这个给你！他说今天是你的“启忆日”！","emotion":"高兴","voice_id":"default","audio_url":null},{"id":3,"shot_no":5,"character_id":1,"speaker_name":"林渊","text":"师父人呢？","emotion":"紧张","voice_id":"default","audio_url":null},{"id":4,"shot_no":5,"character_id":2,"speaker_name":"阿瑶","text":"在后山闭关呢，说让你自己悟。（压低声音）不过我偷听到他跟长老说话，好像……在说什么“天劫要来了”。","emotion":"低语","voice_id":"default","audio_url":null},{"id":5,"shot_no":9,"character_id":null,"speaker_name":"师兄","text":"他们在找“簿子”……快带阿瑶走……","emotion":"紧张","voice_id":"default","audio_url":null},{"id":6,"shot_no":11,"character_id":null,"speaker_name":"长老","text":"宗主，他们来了！这次挡不住了！","emotion":"激动","voice_id":"default","audio_url":null},{"id":7,"shot_no":11,"character_id":3,"speaker_name":"林北望","text":"渊儿和阿瑶送出去了吗？","emotion":"紧张","voice_id":"default","audio_url":null},{"id":8,"shot_no":11,"character_id":null,"speaker_name":"长老","text":"送出去了……可是至宝呢？","emotion":"低语","voice_id":"default","audio_url":null},{"id":9,"shot_no":12,"character_id":3,"speaker_name":"林北望","text":"至宝在我身上。只要我还在，他们找不到……","emotion":"中性","voice_id":"default","audio_url":null},{"id":10,"shot_no":16,"character_id":3,"speaker_name":"林北望","text":"渊儿……守忆宗已经不在了……“火种”不能灭……带阿瑶去北境……至宝在你体内了……记住……每一次使用……都要付出代价……","emotion":"悲伤","voice_id":"default","audio_url":null},{"id":11,"shot_no":18,"character_id":1,"speaker_name":"林渊","text":"（将阿瑶推到身后）闭眼，捂住耳朵。","emotion":"紧张","voice_id":"default","audio_url":null},{"id":12,"shot_no":22,"character_id":1,"speaker_name":"林渊","text":"（轻声）这是……商周？","emotion":"惊讶","voice_id":"default","audio_url":null}]
