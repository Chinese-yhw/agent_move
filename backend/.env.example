# ===== 数据库 / 队列 =====
# docker-compose 会用环境变量覆盖这两个值（postgres/redis 容器名）
# 本地开发用 sqlite，部署到 Docker 时留着也会被覆盖
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/drama_gen
REDIS_URL=redis://redis:6379/0

# ===== 文件存储 =====
# docker-compose 会覆盖为 /srv/data/media（容器内路径）
MEDIA_ROOT=/srv/data/media
MEDIA_BASE_URL=/media

# ===== ComfyUI（AutoDL 公网代理地址）=====
# 例：https://u1164908-xxxx.bjb3.seetacloud.com:8443
COMFYUI_BASE_URL=https://REPLACE_ME.seetacloud.com:8443
# 文生图工作流模板
COMFYUI_IMAGE_WORKFLOW=workflows/z_image_turbo_api.json
# 角色标准照专用：SDXL + FaceID（有素材才生效，没有可注释掉）
COMFYUI_IMAGE_FACEID_WORKFLOW=workflows/sdxl_ipa_faceid_api.json
# 图生视频工作流
COMFYUI_VIDEO_WORKFLOW=workflows/wan21_i2v_api.json
# 文生视频工作流（给纯场景镜头用，不需要首帧图）
COMFYUI_T2V_WORKFLOW=workflows/wan21_t2v_api.json
# 超时（秒）：图片 3 分钟，视频 15 分钟
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_IMAGE_TIMEOUT=180
COMFYUI_VIDEO_TIMEOUT=900

# ===== LLM（DeepSeek）=====
# 👉 必须替换成你自己的 key！
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== TTS =====
# 方案 1：留占位符 → 自动走 edge-tts（零成本兜底，推荐先用）
TTS_BASE_URL=http://REPLACE_ME:50000
# 方案 2：CosyVoice 部署好后填真实 AutoDL 地址（注释掉下一行）
# TTS_BASE_URL=https://你的-cosyvoice-公网地址:50000

TTS_MODE=s1

# ===== 成本估算（前端展示用）=====
GPU_HOURLY_COST=1.88
EST_IMAGE_SECONDS=20
EST_VIDEO_SECONDS_PER_CLIP=300
