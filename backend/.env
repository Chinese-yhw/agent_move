# ===== 数据库 / 队列 =====
# 开发默认 SQLite（零安装）；上生产/部署 Docker 时再换成下一行的 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/drama_gen.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/drama_gen
# Redis：本地没装时代码会自动退化为 eager 模式（任务在 FastAPI 后台线程执行），
# 不需要启动 celery worker。装好本地 Redis 后再启用带密码的版本。
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://:123456@localhost:6379/0

# ===== 文件存储（本地开发用磁盘目录；生产可换 OSS）=====
MEDIA_ROOT=./data/media
MEDIA_BASE_URL=/media

# ===== ComfyUI（AutoDL 公网代理地址，注意带 https 和端口）=====
# 例：https://u1164908-xxxx.bjb2.seetacloud.com:8443
# COMFYUI_BASE_URL=https://u1164908-vm27-10e16560.bjb3.seetacloud.com:8443
COMFYUI_BASE_URL=https://u1164908-8409-15fe3137.westb.seetacloud.com:8443
# 文生图工作流模板（app 导出为 API 格式 json 后放入 workflows/ 目录）
COMFYUI_IMAGE_WORKFLOW=workflows/z_image_turbo_api.json
# 角色一致性首选：SDXL + 角色 LoRA（素材设置 lora_name 后，镜头首帧自动挂载对应 LoRA）
# 这是专业级做法，一致性远强于 IP-Adapter。LoRA 文件需放在 ComfyUI 的 models/loras/ 下
COMFYUI_IMAGE_LORA_WORKFLOW=workflows/sdxl_lora_api.json
# 角色标准照专用：SDXL + FaceID 参考脸一致性，需要素材上传 reference_image 才生效
# 双链路：FaceID 锁脸 + IPAdapter PLUS 锁服装画风（需下载 ip-adapter-plus_sdxl_vit-h.safetensors）
COMFYUI_IMAGE_FACEID_WORKFLOW=workflows/sdxl_dual_ipa_api.json
# FaceID 检测不到人脸时的降级：仅用全风格 IP-Adapter 锁服装画风
COMFYUI_IMAGE_STYLE_WORKFLOW=workflows/sdxl_style_only_api.json
# 图生视频工作流模板
COMFYUI_VIDEO_WORKFLOW=workflows/wan21_i2v_api.json
# 文生视频工作流模板（给特效/黑屏/纯场景镜头用，不需要首帧图）
COMFYUI_T2V_WORKFLOW=workflows/wan21_t2v_api.json
# 单次请求生成张数由代码注入 seed/count
# 超时配置（秒）
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_IMAGE_TIMEOUT=180
COMFYUI_VIDEO_TIMEOUT=900

# ===== LLM（DeepSeek，OpenAI 兼容协议）=====
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== CosyVoice TTS（AutoDL 上另起的 HTTP 服务）=====
TTS_BASE_URL=http://REPLACE_ME:50000
TTS_MODE=s1

